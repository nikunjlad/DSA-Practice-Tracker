[Unit]
Description=Pattern Reps DSA practice tracker (local server)

[Service]
Type=simple
# Adjust this path to wherever you cloned the repo:
WorkingDirectory=%h/dsa-reps
ExecStart=/usr/bin/python3 %h/dsa-reps/server.py
# Don't pop a browser tab at login; just have the server ready:
Environment=BROWSER=/bin/true
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
